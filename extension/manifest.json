{
  "manifest_version": 3,
  "name": "Newsroom Quick Add",
  "version": "1.0.0",
  "description": "Add the current page, a link, or a video to your Newsroom streamer deck.",
  "permissions": ["contextMenus", "activeTab", "storage"],
  "host_permissions": ["https://newsroom-psi-five.vercel.app/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Add to Newsroom" },
  "options_page": "options.html"
}
