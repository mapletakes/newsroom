# --- Twitch ---
# Create an app at https://dev.twitch.tv/console
# Set OAuth Redirect URL to {NEXT_PUBLIC_APP_URL}/api/twitch/callback
NEXT_PUBLIC_TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Supabase ---
# Create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Brave Search API (optional — enables related coverage on streamer deck) ---
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# --- YouTube Data API (optional but recommended) ---
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# --- Twitch EventSub ---
# Secret used to verify EventSub webhook signatures from Twitch.
# Must be 10-100 characters. Generate with: openssl rand -hex 32
EVENTSUB_SECRET=

# --- Admin ---
# Twitch user IDs (numeric, comma-separated) with access to /admin.
ADMIN_TWITCH_IDS=
# If "true", new streamers start unapproved and must be approved in /admin.
REQUIRE_APPROVAL=

# --- App ---
# Vercel sets this automatically in prod; fill for local dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
