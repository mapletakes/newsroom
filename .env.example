# --- Twitch ---
# Create an app at https://dev.twitch.tv/console
# Set OAuth Redirect URL to {NEXT_PUBLIC_APP_URL}/api/twitch/callback
NEXT_PUBLIC_TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Supabase ---
# Create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Brave Search API (optional — enables related coverage on streamer deck) ---
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# --- YouTube Data API (optional but recommended) ---
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# --- Twitch EventSub ---
# Secret used to verify EventSub webhook signatures from Twitch.
# Must be 10-100 characters. Generate with: openssl rand -hex 32
EVENTSUB_SECRET=

# --- Encryption ---
# Encrypts stored OAuth tokens at rest (AES-256-GCM). 64 hex chars (32 bytes).
# Generate with: openssl rand -hex 32
# Keep this STABLE — changing/removing it makes encrypted tokens unrecoverable
# (affected users just re-login). Optional: if unset, tokens are stored as-is.
ENCRYPTION_KEY=

# --- Session ---
# Dedicated key for signing session cookies. Falls back to TWITCH_CLIENT_SECRET
# if unset, but a separate key is recommended. Generate with: openssl rand -hex 32
NEWSROOM_SESSION_SECRET=

# --- Admin ---
# Twitch user IDs (numeric, comma-separated) with access to /admin.
ADMIN_TWITCH_IDS=
# If "true", new streamers start unapproved and must be approved in /admin.
REQUIRE_APPROVAL=

# --- Cron ---
# Authenticates the daily cleanup job (see vercel.json). Vercel sets the
# Authorization header to "Bearer $CRON_SECRET" automatically when it invokes
# a cron route, as long as this env var is set. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- App ---
# Vercel sets this automatically in prod; fill for local dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
